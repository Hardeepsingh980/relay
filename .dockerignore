# Build context for deploy/Dockerfile (docker build -f deploy/Dockerfile .)

# VCS, editor and OS files
.git
.claude
.idea
.vscode
**/.DS_Store

# Secrets: never bake keys into the image (Railway variables supply them at runtime)
.env
.env.*
**/.env
**/.env.*
**/*.pem

# Dependencies and build output (rebuilt inside the image)
**/node_modules
frontend/.next
frontend/out
frontend/next-env.d.ts
**/*.tsbuildinfo
backend/.venv
backend/.pytest_cache
backend/.ruff_cache
**/__pycache__
**/*.pyc

# Local runtime state: keep only the Gemini response cache
# (the image copies deploy/llm-cache.sqlite; refresh it from .cache/llm.sqlite)
.cache/*
!.cache/llm.sqlite
**/*.sqlite-journal

# Not used by the image
demo/
**/*.log
data/**/*.tmp
