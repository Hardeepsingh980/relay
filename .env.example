# Copy to .env (git-ignored). Never commit real keys.
GEMINI_API_KEY=
# Model choices (defaults shown)
RELAY_LLM_MODEL=gemini-3.8-flash
RELAY_EMBED_MODEL=gemini-embedding-2

# FalkorDB
FALKORDB_HOST=localhost
FALKORDB_PORT=6395
# Working graph the API serves (cheerio or lumen); the CLI's default tenant
RELAY_GRAPH=cheerio
RELAY_TENANT=cheerio

# Extraction for unstructured sources: "seed" (deterministic annotations, default) or "gemini" (needs key)
RELAY_EXTRACTOR=seed

# Demo pacing (seconds between investigation steps; 0 = as fast as possible)
# RELAY_STEP_DELAY=0.5
# RELAY_ANALYSIS_DELAY=0.25

# Web app / API
# RELAY_CORS_ORIGINS=http://localhost:3025
# RELAY_PUBLIC_URL=http://localhost:3025        # where the web app runs
# RELAY_API_PUBLIC_URL=http://localhost:8020    # where the API runs (OAuth redirect host)
# RELAY_SECRET_KEY=                             # encrypts stored credentials; generated in .cache/ if unset
# RELAY_COOKIE_SECURE=false                     # true behind HTTPS

# Optional live integrations (otherwise actions run in clearly labelled simulated or draft mode)
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_OAUTH_REFRESH_TOKEN=
# GOOGLE_CALENDAR_ID=primary
# JIRA_BASE_URL=https://your-site.atlassian.net
# JIRA_EMAIL=
# JIRA_API_TOKEN=
# JIRA_PROJECT_KEY=
# SLACK_WEBHOOK_URL=
